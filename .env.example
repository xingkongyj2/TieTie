# Server-only Qoder credential; never use a VITE_ prefix or commit real tokens.
QODER_ACCESS_TOKEN=
# Optional: select an existing managed Session by default.
QODER_DEFAULT_SESSION_ID=
# Optional explicit public origin when deploying behind your own authenticated proxy.
# QODER_ALLOWED_ORIGIN=https://your-app.example.com
# HOST=127.0.0.1
# PORT=4173
