# 与 Node 版 server/ 相同的环境变量约定
# 复制为 .env.local 后填写；.env* 不进 git

# Qoder 云端令牌（必填）
QODER_ACCESS_TOKEN=

# 监听地址与端口（默认 127.0.0.1:4173）
HOST=127.0.0.1
PORT=4173

# 可选 H5 产物目录（小程序代码由微信发布，不由 Go 托管）
STATIC_DIR=../frontend/web/dist

# 默认选中的云端会话（可选）
QODER_DEFAULT_SESSION_ID=

# MySQL 连接参数（启动时自动建库建表，库名只允许字母数字下划线）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tietie
# 本地连接服务器正在使用的真实数据库，沿用现有账号及服务器 CA，校验证书和服务器身份。
# 示例：MYSQL_HOST=38.76.183.142 / MYSQL_USER=root
# CA 放在本地不提交的路径；server-name 必须与服务器证书 SAN 匹配。
MYSQL_TLS_CA_FILE=
MYSQL_TLS_SERVER_NAME=

# 以下仅供 deploy/cnb_tietie.sh 管理服务器的 MySQL 容器。
# root 密码独立于应用 MYSQL_PASSWORD；已有容器沿用原密码，新建容器必须填写。
MYSQL_ROOT_PASSWORD=
# 默认只发布到服务器回环地址。公开绑定必须同时配置来源白名单。
MYSQL_BIND_IP=127.0.0.1
MYSQL_PUBLISHED_PORT=3306
# IPv4/CIDR，多项用逗号或空格分隔；例如 203.0.113.10/32（替换为本机公网 IP）。
MYSQL_ALLOWED_CIDRS=
# 默认自动识别唯一 IPv4 默认路由接口；多入口时需明确指定。
MYSQL_PUBLIC_INTERFACE=

# 绑定新建会话使用的 Agent / 运行环境（可选，留空自动探测）
QODER_AGENT_ID=
QODER_ENVIRONMENT_ID=

# JWT 签名密钥（必填，生产环境用随机长字符串）
JWT_SECRET=
# 令牌有效期（小时），默认 720 = 30 天
JWT_TTL_HOURS=720

# 腾讯云实时语音识别：AppID 是腾讯云账号数字 ID，不是 wx 开头的小程序 ID。
# 密钥仅在后端填写，接口只签发 2 分钟有效的 WSS 会话，禁止提交真实密钥。
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE_MODEL=16k_zh

# 微信小程序一键登录：AppID 与 frontend/project.config.json 一致。
# AppSecret 从微信公众平台获取，仅在服务端设置，禁止放进小程序或提交到 Git。
WECHAT_APP_ID=wx5254fb4764d34a70
WECHAT_APP_SECRET=
# 微信登录与订阅消息 HTTP 请求超时，默认 10 秒，范围 1–60。
WECHAT_TIMEOUT_SECONDS=10

# 提醒订阅消息：从微信公众平台的订阅消息中选用实际适用的模板。
# 模板 3377「聊天消息通知」，场景：用户待办到期提醒。
# 模板 ID 留空时停用微信提醒；必须同时填写当前小程序的 AppID / AppSecret。
WECHAT_REMINDER_TEMPLATE_ID=CInFuaL7JKsYeYecbmanbsZy8TY_31jj77fSZhUH9iM
# 以下关键词名必须与实际模板一致；多余字段显式留空可省略。
# 标题/内容支持 thing(20 字符)、name、phrase、character_string 等文本类型；
# 时间字段只能使用 time 或 date。用户点击消息进入 pages/index/index 聊天页。
# 此模板无单独标题字段；thing1 是通知类型，thing3 是消息来源。
WECHAT_REMINDER_TITLE_KEY=
WECHAT_REMINDER_TYPE_KEY=thing1
WECHAT_REMINDER_SOURCE_KEY=thing3
WECHAT_REMINDER_CONTENT_KEY=thing5
WECHAT_REMINDER_TIME_KEY=time6
# formal 正式版；开发/体验版联调分别使用 developer/trial，页面须存在于对应版本。
WECHAT_MINIPROGRAM_STATE=formal
# 默认一次性订阅；仅微信平台已批准的长期订阅模板才可设 permanent。
# 一次订阅授权只能发送一次消息；没有授权或次数用尽时不能强制发送。
WECHAT_REMINDER_SUBSCRIPTION_TYPE=once

# 云端长期记忆（默认开启）；false 暂停同步，仍保留待同步记录
QODER_MEMORY_ENABLED=true

# 后台队列（所有队列共享并发预算）
# 生产服务器保持 true。本地共用服务器数据库时设 false，避免两套后台同时处理任务。
BACKGROUND_WORKERS_ENABLED=true
SCHEDULER_POLL_SECONDS=1
SCHEDULER_BATCH_SIZE=64
SCHEDULER_CONCURRENCY=4

# 系统 / 调度独立日志，默认各自10MiB轮转
LOG_DIR=logs
LOG_LEVEL=info


# 国内天气仅使用和风天气，未配置时明确报错。
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 推荐长期使用 JWT，配置下面四项后自动签名、续期，优先于 API Key。
QWEATHER_KEY_ID=
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_PRIVATE_KEY_FILE=
