# 与 Node 版 server/ 相同的环境变量约定
# 复制为 .env.local 后填写；.env* 不进 git

# Qoder 云端令牌（必填）
QODER_ACCESS_TOKEN=

# 监听地址与端口（默认 127.0.0.1:4173）
HOST=127.0.0.1
PORT=4173

# 前端构建产物目录（默认 ../frontend/dist，相对运行目录）
STATIC_DIR=../frontend/dist

# 默认选中的云端会话（可选）
QODER_DEFAULT_SESSION_ID=

# MySQL 连接参数（启动时自动建库建表，库名只允许字母数字下划线）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tietie
# 本地连接服务器数据库时，使用专用账号及服务器 CA，校验证书和服务器身份。
# 示例：MYSQL_HOST=38.76.183.142 / MYSQL_USER=tietie_local
# CA 放在本地不提交的路径；server-name 必须与服务器证书 SAN 匹配。
MYSQL_TLS_CA_FILE=
MYSQL_TLS_SERVER_NAME=

# 以下仅供 deploy/cnb_tietie.sh 管理服务器的 MySQL 容器。
# root 密码独立于应用 MYSQL_PASSWORD；已有容器沿用原密码，新建容器必须填写。
MYSQL_ROOT_PASSWORD=
# 默认只发布到服务器回环地址。公开绑定必须同时配置来源白名单。
MYSQL_BIND_IP=127.0.0.1
MYSQL_PUBLISHED_PORT=3306
# IPv4/CIDR，多项用逗号或空格分隔；例如 203.0.113.10/32（替换为本机公网 IP）。
MYSQL_ALLOWED_CIDRS=
# 默认自动识别唯一 IPv4 默认路由接口；多入口时需明确指定。
MYSQL_PUBLIC_INTERFACE=

# 绑定新建会话使用的 Agent / 运行环境（可选，留空自动探测）
QODER_AGENT_ID=
QODER_ENVIRONMENT_ID=

# JWT 签名密钥（必填，生产环境用随机长字符串）
JWT_SECRET=
# 令牌有效期（小时），默认 720 = 30 天
JWT_TTL_HOURS=720

# 云端长期记忆（默认开启）；false 暂停同步，仍保留待同步记录
QODER_MEMORY_ENABLED=true

# 后台队列（所有队列共享并发预算）
# 生产服务器保持 true。本地共用服务器数据库时设 false，避免两套后台同时处理任务。
BACKGROUND_WORKERS_ENABLED=true
SCHEDULER_POLL_SECONDS=1
SCHEDULER_BATCH_SIZE=64
SCHEDULER_CONCURRENCY=4

# 系统 / 调度独立日志，默认各自10MiB轮转
LOG_DIR=logs
LOG_LEVEL=info


# 国内天气仅使用和风天气，未配置时明确报错。
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 推荐长期使用 JWT，配置下面四项后自动签名、续期，优先于 API Key。
QWEATHER_KEY_ID=
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_PRIVATE_KEY_FILE=
